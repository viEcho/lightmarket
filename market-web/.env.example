# 智能合约配置
# ====================

# Factory 合约地址（部署后填写）
# 例如: VITE_FACTORY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_FACTORY_ADDRESS=

# USDC 合约地址
# 例如: VITE_USDC_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
VITE_USDC_ADDRESS=

# 网络 ID
# - 31337: 本地 Hardhat 网络
# - 11155111: Sepolia 测试网
# - 1: 以太坊主网
VITE_CHAIN_ID=31337
